<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Razor SDK：讓專案能編譯 .razor 畫面元件 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SerialManager</RootNamespace>
    <!-- exe 在檔案總管、捷徑上顯示的圖示 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- 視窗、工作列、系統匣用的圖示：包進 exe 裡，執行時讀出來 -->
    <EmbeddedResource Include="app.ico" LogicalName="SerialManager.app.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="10.0.110" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

</Project>
