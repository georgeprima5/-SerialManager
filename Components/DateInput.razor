@* 日期欄：點欄位任何地方都打開日期選擇器；空白時顯示「年/月/日」 *@
<span class="date-box @(Value is null ? "empty" : "")">
    <input class="input @(Invalid ? "invalid" : "")" type="date" onclick="this.showPicker?.()"
           value="@Value?.ToString("yyyy-MM-dd")" @onchange="OnChange" />
    <span class="date-placeholder">年/月/日</span>
</span>

@code {
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public bool Invalid { get; set; }

    private async Task OnChange(ChangeEventArgs e)
    {
        Value = DateTime.TryParse(e.Value?.ToString(), out var date) ? date : null;
        await ValueChanged.InvokeAsync(Value);
    }
}
